{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@kaabe/runtime": ["./src/runtime-types.d.ts"],
      "@/*": ["../../apps/erp/src/*"],
      "@erp/ui": ["../../packages/ui/src/index.ts"],
      "@erp/ui/fixtures": ["../../packages/ui/src/fixtures/index.ts"]
    }
  },
  "include": ["src"]
}
