{
  "buildCommand": "npm run build",
  "outputDirectory": "apps/erp/dist",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    {
      "source": "/storybook",
      "destination": "/storybook/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|storybook/).*)",
      "destination": "/index.html"
    }
  ]
}
